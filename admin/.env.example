# Plantilla de `admin/.env`, el de la app de administración local (ADR-025). Copiala a `.env` y
# completá los valores en el servidor del laboratorio.
#
# `.env` está en .gitignore y NUNCA se versiona. Este archivo tampoco lleva valores reales.

# DSN asincrónico de la base que administra el panel. Las mismas reglas que `backend/.env.example`.
DS_DATABASE_URL=postgresql+asyncpg://usuario:contrasena@host:5432/postgres?ssl=require

# Puerto del panel. El host no se configura: siempre es 127.0.0.1.
DS_ADMIN_PORT=5000

# Base de Data Dragon, para el seed de campeones.
DS_DDRAGON_BASE_URL=https://ddragon.leagueoflegends.com
