# Plantilla de `backend/.env`. Copiala a `.env` y completá los valores.
#
# `.env` está en .gitignore y NUNCA se versiona. Este archivo tampoco lleva valores reales:
# sólo los nombres de las claves y el formato que esperan.

# DSN asincrónico de Postgres. Con Supabase tiene que ser el del **Session pooler, puerto 5432**:
# la conexión directa sólo publica AAAA y no resuelve sin IPv6, y el pooler transaccional (6543)
# no admite sentencias preparadas, con lo que Alembic falla contra él.
DS_DATABASE_URL=postgresql+asyncpg://usuario:contrasena@host:5432/postgres?ssl=require

# Clave de los endpoints /admin/*. Con esta variable vacía, el guard rechaza todo: un despliegue
# al que se le olvidó configurarla tiene que quedar cerrado, no abierto.
DS_ADMIN_KEY=

# Origen permitido por CORS. Es el dominio concreto, nunca `*`: con credenciales el comodín es
# inválido por especificación y la cookie de sesión no viajaría.
DS_CORS_ORIGIN=http://localhost:5173

# Base de Data Dragon, para el seeder de campeones.
DS_DDRAGON_BASE_URL=https://ddragon.leagueoflegends.com
